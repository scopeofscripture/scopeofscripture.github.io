/* ============================================================
   Scope of Scripture — shared stylesheet
   Theme: "excavation" — strata bands, aged parchment, inscribed type
   ============================================================ */

@import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap');

:root{
  --parchment:      #E8DFC7;
  --parchment-alt:  #DED2B2;
  --ink:            #241F17;
  --stone:          #6B5D48;
  --clay:           #8B4226;
  --clay-dark:      #6E3319;
  --strata-navy:    #232C33;
  --strata-navy-2:  #2E3A42;
  --gold:           #A9863F;
  --line:           rgba(36,31,23,0.15);
  --radius: 2px;
}

*{ box-sizing:border-box; }
html{ scroll-behavior:smooth; }

body{
  margin:0;
  background:var(--parchment);
  color:var(--ink);
  font-family:'Source Serif 4', Georgia, serif;
  font-size:18px;
  line-height:1.65;
}

h1,h2,h3,.display{
  font-family:'Fraunces', Georgia, serif;
  font-weight:600;
  line-height:1.08;
  margin:0 0 0.4em;
  letter-spacing:-0.01em;
}

.eyebrow{
  font-family:'Inter', sans-serif;
  font-size:12px;
  font-weight:600;
  letter-spacing:0.14em;
  text-transform:uppercase;
  color:var(--clay);
}

a{ color:var(--clay); text-decoration:none; }
a:hover{ color:var(--clay-dark); }
a:focus-visible, button:focus-visible{
  outline:3px solid var(--gold);
  outline-offset:2px;
}

img{ max-width:100%; display:block; }

.wrap{
  max-width:1080px;
  margin:0 auto;
  padding:0 28px;
}

/* ---------- Strata band motif (the signature element) ---------- */
.strata{
  height:14px;
  width:100%;
  background:
    repeating-linear-gradient(
      90deg,
      var(--clay) 0 8%,
      var(--gold) 8% 22%,
      var(--stone) 22% 38%,
      var(--strata-navy) 38% 55%,
      var(--clay-dark) 55% 70%,
      var(--gold) 70% 86%,
      var(--stone) 86% 100%
    );
  background-size: 340px 100%;
}

/* ---------- Header ---------- */
.site-header{
  background:var(--strata-navy);
  color:var(--parchment);
}
.site-header .wrap{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding-top:22px;
  padding-bottom:22px;
  gap:24px;
  flex-wrap:wrap;
}
.brand{
  font-family:'Fraunces', Georgia, serif;
  font-weight:700;
  font-size:24px;
  color:var(--parchment);
  letter-spacing:-0.01em;
}
.brand small{
  display:block;
  font-family:'Inter', sans-serif;
  font-weight:500;
  font-size:11px;
  letter-spacing:0.16em;
  text-transform:uppercase;
  color:var(--gold);
  margin-top:2px;
}
nav.main-nav{
  display:flex;
  gap:26px;
  flex-wrap:wrap;
  font-family:'Inter', sans-serif;
  font-size:14px;
  font-weight:500;
}
nav.main-nav a{
  color:var(--parchment);
  opacity:0.85;
  padding:6px 0;
  border-bottom:2px solid transparent;
}
nav.main-nav a:hover, nav.main-nav a.active{
  opacity:1;
  color:var(--gold);
  border-bottom-color:var(--gold);
}

/* ---------- Buttons ---------- */
.btn{
  display:inline-flex;
  align-items:center;
  gap:8px;
  font-family:'Inter', sans-serif;
  font-weight:600;
  font-size:14px;
  letter-spacing:0.02em;
  padding:12px 22px;
  border-radius:var(--radius);
  border:1.5px solid var(--clay);
  cursor:pointer;
  transition:transform .12s ease, background .15s ease, color .15s ease;
}
.btn-primary{
  background:var(--clay);
  color:var(--parchment);
}
.btn-primary:hover{
  background:var(--clay-dark);
  border-color:var(--clay-dark);
  color:var(--parchment);
  transform:translateY(-1px);
}
.btn-outline{
  background:transparent;
  color:var(--clay);
}
.btn-outline:hover{
  background:var(--clay);
  color:var(--parchment);
  transform:translateY(-1px);
}
.btn-navy{
  border-color:var(--strata-navy);
  background:var(--strata-navy);
  color:var(--parchment);
}
.btn-navy:hover{
  background:var(--strata-navy-2);
  color:var(--parchment);
  transform:translateY(-1px);
}

/* ---------- Hero ---------- */
.hero{
  background:var(--parchment-alt);
  padding:76px 0 64px;
  border-bottom:1px solid var(--line);
}
.hero .verse{
  font-family:'Fraunces', Georgia, serif;
  font-style:italic;
  font-weight:500;
  font-size:19px;
  color:var(--stone);
  max-width:640px;
  margin:0 0 28px;
  padding-left:18px;
  border-left:3px solid var(--clay);
}
.hero h1{
  font-size:clamp(36px, 5.4vw, 62px);
  max-width:780px;
}
.hero p.lede{
  max-width:600px;
  font-size:19px;
  color:var(--stone);
  margin-top:18px;
}
.hero .cta-row{
  display:flex;
  gap:14px;
  margin-top:34px;
  flex-wrap:wrap;
}

/* ---------- Sections ---------- */
section{ padding:64px 0; }
section.alt{ background:var(--parchment-alt); }
.section-head{ margin-bottom:36px; max-width:640px; }

/* ---------- Stat blocks ---------- */
.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1px;
  background:var(--line);
  border:1px solid var(--line);
}
.stat{
  background:var(--parchment);
  padding:30px 26px;
}
.stat .num{
  font-family:'Fraunces', Georgia, serif;
  font-weight:700;
  font-size:40px;
  color:var(--clay);
}
.stat .label{
  font-family:'Inter', sans-serif;
  font-size:13px;
  color:var(--stone);
  margin-top:6px;
}

/* ---------- Cards (content categories / articles / books) ---------- */
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(230px,1fr));
  gap:22px;
}
.card{
  background:var(--parchment);
  border:1px solid var(--line);
  padding:26px 24px;
  position:relative;
}
.card::before{
  content:"";
  position:absolute; top:0; left:0; right:0; height:4px;
  background:var(--clay);
}
.card h3{ font-size:20px; margin-bottom:10px; }
.card p{ color:var(--stone); font-size:15.5px; margin:0; }

.article-card{
  background:var(--parchment);
  border:1px solid var(--line);
  padding:28px;
  display:flex;
  flex-direction:column;
  gap:14px;
}
.article-card .eyebrow{ margin-bottom:2px; }
.article-card h3{ font-size:22px; }
.article-card p{ color:var(--stone); margin:0; }
.article-card .card-actions{
  margin-top:auto;
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  padding-top:8px;
}

/* ---------- Book / shop entries ---------- */
.book-entry{
  display:grid;
  grid-template-columns:120px 1fr;
  gap:24px;
  padding:28px 0;
  border-bottom:1px solid var(--line);
}
.book-entry:first-of-type{ border-top:1px solid var(--line); }
.book-cover{
  width:120px; height:160px;
  background:linear-gradient(160deg, var(--strata-navy), var(--strata-navy-2));
  border:1px solid var(--line);
  display:flex; align-items:center; justify-content:center;
  color:var(--gold);
  font-family:'Fraunces', serif;
  font-size:13px;
  text-align:center;
  padding:10px;
}
.book-info h3{ font-size:22px; margin-bottom:6px; }
.book-info p{ color:var(--stone); margin:0 0 16px; max-width:60ch; }

/* ---------- Article body (single article page) ---------- */
.article-body{ max-width:680px; }
.article-body .eyebrow{ margin-bottom:10px; }
.article-body h1{ font-size:clamp(30px,4.5vw,44px); margin-bottom:18px; }
.article-body p{ margin:0 0 20px; }
.article-body .drop-note{
  font-family:'Inter', sans-serif;
  font-size:14px;
  color:var(--stone);
  border-top:1px solid var(--line);
  padding-top:18px;
  margin-top:8px;
}
.book-cta{
  margin-top:44px;
  padding:30px;
  background:var(--strata-navy);
  color:var(--parchment);
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:20px;
  flex-wrap:wrap;
}
.book-cta h3{ color:var(--parchment); font-size:22px; margin-bottom:4px; }
.book-cta p{ color:#C9BFA6; margin:0; font-family:'Inter',sans-serif; font-size:14px; }

/* ---------- Footer ---------- */
footer{
  background:var(--strata-navy);
  color:#C9BFA6;
  padding:44px 0 32px;
  font-family:'Inter', sans-serif;
  font-size:14px;
}
footer a{ color:var(--parchment); }
footer .foot-grid{
  display:flex;
  justify-content:space-between;
  flex-wrap:wrap;
  gap:24px;
  padding-bottom:24px;
  border-bottom:1px solid rgba(255,255,255,0.12);
  margin-bottom:20px;
}
footer .disclaimer{
  font-size:12.5px;
  line-height:1.6;
  color:#93917f;
  max-width:820px;
}

@media (max-width:640px){
  .stats{ grid-template-columns:1fr; }
  .book-entry{ grid-template-columns:1fr; }
  .book-cover{ width:88px; height:120px; }
}

.photo-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit, minmax(180px,1fr));
  gap:16px;
  margin-top:20px;
}
.photo-grid img{
  width:100%;
  height:220px;
  object-fit:cover;
  border-radius:6px;
  box-shadow:0 3px 10px rgba(0,0,0,0.25);
}
.region-block{
  margin-bottom:56px;
}
.region-block:last-child{
  margin-bottom:0;
}

.nav-donate{
  color:var(--clay) !important;
  font-weight:600;
}
